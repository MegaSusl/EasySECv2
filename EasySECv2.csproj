	  </MauiXaml>
	</ItemGroup>
	<PropertyGroup Condition="'$(TargetFramework)' == 'net9.0-windows10.0.19041.0'">
		<!-- цель и архитектура -->
		<RuntimeIdentifier>win10-x64</RuntimeIdentifier>

		<!-- разворачиваем без MSIX, чистая EXE -->
		<WindowsPackageType>None</WindowsPackageType>

		<!-- делаем самодостаточный один файл -->
		<SelfContained>true</SelfContained>
		<PublishSingleFile>true</PublishSingleFile>

		<!-- чтобы нативные библиотеки (SQLite) упаковывались внутрь exe -->
		<IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>

		<!-- уменьшение размера; выключите, если отражение/DocX ломаются -->
		<PublishTrimmed>false</PublishTrimmed>
	</PropertyGroup>

</Project>
