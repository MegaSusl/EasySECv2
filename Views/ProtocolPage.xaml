<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:EasySECv2.ViewModels"
             x:Class="EasySECv2.Views.ProtocolPage">
    <ContentPage.BindingContext>
        <viewmodels:ProtocolViewModel />
    </ContentPage.BindingContext>

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="16">
            <Label Text="Шаблоны протоколов" FontSize="18" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}"/>

            <HorizontalStackLayout Spacing="12">
                <Picker ItemsSource="{Binding Templates}"
                    ItemDisplayBinding="{Binding Name}"
                    SelectedItem="{Binding SelectedTemplate}" TextColor="{StaticResource TextPrimary}" WidthRequest="400"/>
                <Button Text="Добавить шаблон" Command="{Binding AddTemplateCommand}" />
                <Button Text="Удалить шаблон" Command="{Binding DeleteTemplateCommand}" IsEnabled="{Binding CanDeleteTemplate}" />
            </HorizontalStackLayout>

            <Label Text="Папка сохранения документов:" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}"/>
            <Button Text="Выбрать папку" Command="{Binding SelectFolderCommand}" />
            <Label Text="{Binding OutputFolder}" FontSize="12" LineBreakMode="WordWrap" TextColor="{StaticResource TextPrimary}"/>

            <Label Text="Поиск студентов:" TextColor="{StaticResource TextPrimary}"/>
            <SearchBar Placeholder="Введите ФИО" Text="{Binding SearchQuery}" />

            <Border Stroke="{StaticResource PrimaryLight}" 
                    StrokeThickness="1"
                    BackgroundColor="{StaticResource BackgroundAlt}"
                    Padding="12">

                <VerticalStackLayout Spacing="10">

                    <Label Text="Допущенные студенты" FontSize="20"
                           FontAttributes="Bold" 
                           TextColor="{StaticResource TextPrimary}" />

                    <CollectionView ItemsSource="{Binding FilteredStudents}">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="Auto,*,Auto"
                                      IsVisible="{Binding IsVisible}" 
                                      BackgroundColor="White"
                                      Padding="0,4">

                                    <!-- Имя студента слева, в рамке -->
                                    <Border Stroke="{StaticResource PrimaryLight}" 
                                            StrokeThickness="1" 
                                            BackgroundColor="{StaticResource BackgroundAlt}"
                                            Padding="8,4"
                                            Grid.Column="0"
                                            VerticalOptions="Center">

                                        <Label Text="{Binding Student.FullName}" 
                                               VerticalOptions="Center"
                                               TextColor="{StaticResource TextPrimary}" />
                                    </Border>

                                    <!-- Кнопка справа -->
                                    <Button Text="Сгенерировать протокол"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:ProtocolViewModel}}, Path=GenerateCommand}"
                                            CommandParameter="{Binding Student}"
                                            IsEnabled="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:ProtocolViewModel}}, Path=CanGenerate}"
                                            Grid.Column="2" />
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
