<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:m="clr-namespace:EasySECv2.Models"
             xmlns:viewmodels="clr-namespace:EasySECv2.ViewModels"
             x:Class="EasySECv2.Views.FamiliarizationPage"
             Title="Лист ознакомления">

    <ContentPage.BindingContext>
        <viewmodels:FamiliarizationViewModel />
    </ContentPage.BindingContext>

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="16">
            <Label Text="Шаблоны" FontSize="18" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}"/>

            <HorizontalStackLayout Spacing="12">
                <Picker ItemsSource="{Binding Templates}"
                ItemDisplayBinding="{Binding Name}"
                SelectedItem="{Binding SelectedTemplate}" TextColor="{StaticResource TextPrimary}" WidthRequest="400"/>
                <Button Text="Добавить шаблон" Command="{Binding AddTemplateCommand}" />
                <Button Text="Удалить шаблон" Command="{Binding DeleteTemplateCommand}" IsEnabled="{Binding CanDeleteTemplate}" />
            </HorizontalStackLayout>

            <Label Text="Папка сохранения документов:" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}"/>
            <Button Text="Выбрать папку" Command="{Binding SelectFolderCommand}" />
            <Label Text="{Binding OutputFolder}" FontSize="12" LineBreakMode="WordWrap" TextColor="{StaticResource TextPrimary}"/>

            <Label Text="Поиск студентов:" TextColor="{StaticResource TextPrimary}"/>
            <SearchBar Placeholder="Введите ФИО" Text="{Binding SearchQuery}" />

            <Label Text="Допущенные студенты" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}"/>
            <CollectionView ItemsSource="{Binding FilteredGroups}">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="m:SelectableGroup">
                        <Grid ColumnDefinitions="Auto, *, Auto"
                              IsVisible="{Binding IsVisible}" BackgroundColor="White"
                              Padding="0,4">

                            <!-- Название группы слева, обёрнуто в Border -->
                            <Border Stroke="{StaticResource PrimaryLight}" 
                                    StrokeThickness="1" 
                                    BackgroundColor="{StaticResource BackgroundAlt}"
                                    Padding="8,4"
                                    Grid.Column="0" WidthRequest="200"
                                    VerticalOptions="Center">

                                <Label Text="{Binding Group.Name}" 
                                       VerticalOptions="Center"
                                       TextColor="{StaticResource TextPrimary}" WidthRequest="180"/>
                            </Border>

                            <!-- Кнопка справа -->
                            <Button Text="Сгенерировать протокол"
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:FamiliarizationViewModel}}, Path=GenerateCommand}"
                                    CommandParameter="{Binding Group}"
                                    IsEnabled="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:FamiliarizationViewModel}}, Path=CanGenerate}"
                                    Grid.Column="2" />
                        </Grid>


                    </DataTemplate>

                </CollectionView.ItemTemplate>
            </CollectionView>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
